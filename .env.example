# Copie este arquivo para `.env` e preencha os valores do seu projeto Supabase.
# NUNCA commite o arquivo `.env` com valores reais — ele está no .gitignore.

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL pública do app web usada nos redirects de e-mail do Supabase.
VITE_APP_URL="https://balanced-you-plan.vercel.app"

# Login nativo com Google (deep link) no app empacotado. Deixe "false" até configurar
# o OAuth Client no Google Cloud e o provider no Supabase — ver GOOGLE_LOGIN_NATIVO.md.
VITE_ENABLE_NATIVE_GOOGLE=false