# Secrets das Edge Functions (NÃO são variáveis do front). Sem valores aqui: este arquivo é versionado.
# Copie para .env.secrets.local (ignorado pelo git), preencha e cadastre no projeto Supabase com:
#   npx supabase@2 secrets set --env-file .env.secrets.local --project-ref <REF_DO_PROJETO>
#   npx supabase@2 secrets list --project-ref <REF_DO_PROJETO>   # confere só os nomes
#
# Obrigatório: chave da API do Gemini (Google AI Studio → Get API key).
GEMINI_API_KEY=
# Opcionais (o padrão está em supabase/functions/_shared/aiClient.ts):
# AI_MODEL=gemini-2.5-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Só no projeto de TESTE: true faz meal-plan/meal-swap devolverem respostas fixas, sem chamar a IA.
MOCK_AI=false
